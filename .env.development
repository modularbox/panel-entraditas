# Solo se aplica con "npm run dev": apunta a la API de produccion de api.entraditas.com,
# que sirve el catalogo publico y la autenticacion de panel desde MySQL.
VITE_API_URL=https://api.entraditas.com
# Dónde abre el panel la sesión de un cliente ("Conectar"). En desarrollo es el servidor de Vite
# de la web; en producción es entraditas.com.
VITE_WEB_URL=http://localhost:5173