# Los tests corren contra los mocks, nunca contra api.entraditas.com. Vaciar la variable aqui
# evita que el .env de la maquina cambie lo que hacen: sin esto, los tests intentaban iniciar
# sesion de verdad contra la API y el resultado dependia de que hubiera en el entorno local.
VITE_API_URL=
# Igual que la API: sin URL la web de clientes queda inactiva y el boton "Conectar" no sale.
VITE_WEB_URL=
